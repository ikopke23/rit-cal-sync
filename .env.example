# Google Calendar ID to sync into (required for sync)
CALENDAR_ID=
# Path to the OAuth Desktop client JSON from Google Cloud Console (required for sync)
GOOGLE_CREDENTIALS_FILE=
# Path where the OAuth token is stored after first consent (required for sync)
GOOGLE_TOKEN_FILE=
# Academic calendar page to scrape
CALENDAR_URL=https://www.rit.edu/calendar
# Comma-separated term seasons to include (case-insensitive)
TERM_SEASONS=Fall,Spring
# IANA timezone used to compute "today" for logs
TIMEZONE=America/New_York
# HTTP request timeout as a Go duration
HTTP_TIMEOUT=30s
# Log level: debug, info, warn or error
LOG_LEVEL=info
